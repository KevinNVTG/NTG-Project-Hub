:root {
  --navy: #17283a;
  --navy-2: #223b53;
  --silver: #b8bec5;
  --ink: #17202a;
  --muted: #647180;
  --line: #dce1e6;
  --panel: #ffffff;
  --bg: #f4f6f8;
  --success: #1c7c54;
}
* { box-sizing: border-box; }
html, body { margin: 0; padding: 0; font-family: Arial, Helvetica, sans-serif; color: var(--ink); background: var(--bg); }
a { color: inherit; text-decoration: none; }
button, input, select, textarea { font: inherit; }
.shell { min-height: 100vh; display: grid; grid-template-columns: 250px 1fr; }
.sidebar { background: var(--navy); color: white; padding: 22px 16px; position: sticky; top: 0; height: 100vh; }
.brand { display: flex; align-items: center; gap: 12px; margin-bottom: 26px; }
.brand img { width: 52px; height: 52px; object-fit: contain; }
.brand strong { display: block; font-size: 16px; }
.brand span { color: #cbd3da; font-size: 12px; }
.nav { display: grid; gap: 6px; }
.nav a { padding: 11px 12px; border-radius: 8px; color: #e9eef2; }
.nav a:hover { background: var(--navy-2); }
.main { min-width: 0; }
.topbar { background: white; border-bottom: 1px solid var(--line); padding: 17px 26px; display: flex; justify-content: space-between; align-items: center; }
.content { padding: 26px; max-width: 1400px; margin: 0 auto; }
.page-title { margin: 0 0 6px; font-size: 28px; }
.page-subtitle { margin: 0 0 24px; color: var(--muted); }
.grid { display: grid; gap: 18px; }
.stats { grid-template-columns: repeat(4, minmax(0, 1fr)); }
.card { background: var(--panel); border: 1px solid var(--line); border-radius: 12px; padding: 20px; box-shadow: 0 3px 12px rgba(22, 36, 50, 0.04); }
.stat-label { color: var(--muted); font-size: 13px; }
.stat-value { margin-top: 9px; font-size: 30px; font-weight: 700; }
.section-head { display: flex; justify-content: space-between; align-items: center; margin: 28px 0 12px; }
.section-head h2 { margin: 0; font-size: 19px; }
.btn { display: inline-flex; align-items: center; justify-content: center; border: 0; border-radius: 8px; padding: 10px 14px; cursor: pointer; font-weight: 700; }
.btn-primary { background: var(--navy); color: white; }
.btn-secondary { background: #e9edf1; color: var(--ink); }
.table-wrap { overflow-x: auto; }
table { width: 100%; border-collapse: collapse; }
th, td { text-align: left; padding: 13px 12px; border-bottom: 1px solid var(--line); }
th { color: var(--muted); font-size: 12px; text-transform: uppercase; letter-spacing: .04em; }
.badge { display: inline-block; padding: 5px 9px; border-radius: 999px; font-size: 12px; background: #e7f4ed; color: var(--success); }
.form-grid { display: grid; grid-template-columns: repeat(2, minmax(0,1fr)); gap: 16px; }
.field { display: grid; gap: 7px; }
.field label { font-size: 13px; font-weight: 700; }
.field input, .field select, .field textarea { width: 100%; border: 1px solid #cfd6dc; background: white; border-radius: 8px; padding: 11px 12px; }
.field textarea { min-height: 100px; resize: vertical; }
.full { grid-column: 1 / -1; }
.login-page { min-height: 100vh; display: grid; place-items: center; padding: 24px; background: radial-gradient(circle at top, #314b63, #152535 60%); }
.login-card { width: min(430px, 100%); background: white; border-radius: 16px; padding: 32px; box-shadow: 0 25px 70px rgba(0,0,0,.28); }
.login-logo { width: 110px; height: 110px; object-fit: contain; display: block; margin: 0 auto 12px; }
.login-card h1 { text-align: center; margin: 0; }
.login-card p { text-align: center; color: var(--muted); margin: 6px 0 24px; }
.error { color: #a4262c; background: #fdecee; padding: 10px 12px; border-radius: 8px; margin-bottom: 14px; }
@media (max-width: 900px) { .shell { grid-template-columns: 1fr; } .sidebar { height: auto; position: static; } .stats { grid-template-columns: repeat(2,1fr); } }
@media (max-width: 600px) { .stats, .form-grid { grid-template-columns: 1fr; } .content { padding: 18px; } }
